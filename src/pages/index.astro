---
import { getCollection } from 'astro:content';
import Pagination from '../components/Pagination.astro';
import SiteCard from '../components/SiteCard.astro';
import TagPills from '../components/TagPills.astro';
import { FACETS, type FacetKey, facetValues } from '../facets.ts';
import { absoluteUrl, facetSlug, withBase } from '../helpers.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { collectionPageNode } from '../schema.ts';

const allSites = await getCollection('sites');
const allDevelopers = await getCollection('developers');

const developerMap = new Map(allDevelopers.map((d) => [d.id, d]));

const PAGE_SIZE = 12;

const sortedSites = allSites.sort(
  (a, b) =>
    new Date(b.data.latest_revision_created_at).getTime() -
    new Date(a.data.latest_revision_created_at).getTime(),
);

const totalPages = Math.ceil(sortedSites.length / PAGE_SIZE);
const pageSites = sortedSites.slice(0, PAGE_SIZE);

const sectorCounts = new Map<string, number>();
for (const site of allSites) {
  for (const value of site.data.sector) {
    sectorCounts.set(value, (sectorCounts.get(value) ?? 0) + 1);
  }
}
const sectors = Array.from(sectorCounts.entries())
  .map(([name, count]) => ({ name, slug: facetSlug(name), count }))
  .sort((a, b) => b.count - a.count);

// Counts for the scope statement, computed from the collections so they
// never go stale.
const facetCount = (Object.keys(FACETS) as FacetKey[]).reduce(
  (sum, facet) => sum + facetValues(facet, allSites).length,
  0,
);

function getCooperator(cooperatorSlug: string) {
  return developerMap.get(cooperatorSlug);
}

// Listing schema for the 12 cards on this page.
const jsonLd = [
  collectionPageNode({
    path: '/',
    name: 'Made with Wagtail',
    items: pageSites.map((site) => ({
      name: site.data.title,
      url: absoluteUrl(`/developers/${site.id}/`),
    })),
  }),
];
---

<BaseLayout jsonLd={jsonLd}>
  <div class="banner content-width">
    <h1>A showcase of sites and apps made with Wagtail CMS</h1>
    <div class="intro">
      <p>
        Made with Wagtail is a showcase of {allSites.length} production websites and apps built with{' '}
        <a href="https://wagtail.org/">Wagtail</a>, the open source Django content management
        system, submitted by {allDevelopers.length} developers and agencies across{' '}
        {facetCount}{' '}
        collections.
      </p>
      <p>
        Maintained by the Wagtail project. To see your site here,{' '}
        <a href={withBase('/submit-your-site/')}>submit it for review</a>.
      </p>
    </div>
  </div>

  <div class="content-width vertical-bottom-l">
    <TagPills facet="sector" values={sectors.slice(0, 10)} />
    <p>
      <a href={withBase('/sites/')}>All sectors, types, and capabilities</a>
    </p>
  </div>

  <div class="content-width">
    <div class="grid grid-stack site-listing">
      {pageSites.map((site, index) => {
        const dev = developerMap.get(site.id.split('/')[0]);
        return (
          <SiteCard
            title={site.data.title}
            url={withBase(`/developers/${site.id}/`)}
            developerName={dev?.data.title ?? 'A Wagtail developer'}
            developerUrl={withBase(dev ? `/developers/${dev.id}/` : '/developers/')}
            id={site.id}
            siteUrl={site.data.site_url}
            eager={index < 3}
            inCooperationWith={site.data.in_cooperation_with_slug
              ? getCooperator(site.data.in_cooperation_with_slug)?.data.title
              : null
            }
            inCooperationWithUrl={
              site.data.in_cooperation_with_slug
                ? withBase(
                    getCooperator(site.data.in_cooperation_with_slug)
                      ? `/developers/${site.data.in_cooperation_with_slug}/`
                      : '/developers/',
                  )
              : null
            }
          />
        );
      })}
    </div>

    {totalPages > 1 && (
      <Pagination
        page={{
          currentPage: 1,
          lastPage: totalPages,
          total: sortedSites.length,
          url: {
            current: withBase('/'),
            prev: undefined,
            next: withBase('/page/2'),
            first: undefined,
            last: withBase(`/page/${totalPages}`),
          },
        }}
      />
    )}
  </div>
</BaseLayout>
