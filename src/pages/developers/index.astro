---
import { getCollection } from 'astro:content';
import DeveloperCard from '../../components/DeveloperCard.astro';
import Pagination from '../../components/Pagination.astro';
import { absoluteUrl, withBase } from '../../helpers.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { collectionPageNode } from '../../schema.ts';

const allDevelopers = await getCollection('developers');
const allSites = await getCollection('sites');

// Count owned sites plus collaborations (in_cooperation_with_slug).
const siteCounts = new Map<string, number>();
const bump = (slug: string) => siteCounts.set(slug, (siteCounts.get(slug) ?? 0) + 1);
for (const site of allSites) {
  bump(site.id.split('/')[0]);
  if (site.data.in_cooperation_with_slug) bump(site.data.in_cooperation_with_slug);
}

const developersWithCounts = allDevelopers.map((dev) => ({
  ...dev,
  sitesCount: siteCounts.get(dev.id) ?? 0,
}));

const sortedDevelopers = developersWithCounts.sort((a, b) => {
  const countDiff = b.sitesCount - a.sitesCount;
  if (countDiff !== 0) return countDiff;
  return (
    new Date(b.data.latest_revision_created_at).getTime() -
    new Date(a.data.latest_revision_created_at).getTime()
  );
});

const PAGE_SIZE = 12;
const pageDevelopers = sortedDevelopers.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(sortedDevelopers.length / PAGE_SIZE);

// Listing schema for the 12 developer cards on this page.
const jsonLd = [
  collectionPageNode({
    path: '/developers/',
    name: 'Developers',
    items: pageDevelopers.map((dev) => ({
      name: dev.data.title,
      url: absoluteUrl(`/developers/${dev.id}/`),
    })),
  }),
];
---

<BaseLayout title="Developers" jsonLd={jsonLd}>
  <div class="content-width">
    <div class="banner">
      <h1>Developers</h1>
      <div class="intro">
        <p>Companies and developers building sites with Wagtail.</p>
      </div>
    </div>

    <div class="grid-float">
      {pageDevelopers.map((dev) => (
        <DeveloperCard
          title={dev.data.title}
          url={withBase(`/developers/${dev.id}/`)}
          id={dev.id}
          location={dev.data.location}
          sitesCount={dev.sitesCount}
        />
      ))}
    </div>

    {totalPages > 1 && (
      <Pagination
        page={{
          currentPage: 1,
          lastPage: totalPages,
          total: sortedDevelopers.length,
          url: {
            current: withBase('/developers/'),
            prev: undefined,
            next: withBase('/developers/page/2'),
            first: undefined,
            last: withBase(`/developers/page/${totalPages}`),
          },
        }}
      />
    )}
  </div>
</BaseLayout>
